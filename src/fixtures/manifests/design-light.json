        },
        "heading": {
          "$type": "fontFamily",
          "$value": "var(--font-playfair), 'Playfair Display', Georgia, 'Times New Roman', serif"
        },
        "display": {
          "$type": "fontFamily",
          "$value": "var(--font-playfair), 'Playfair Display', Georgia, 'Times New Roman', serif"
        },
        "headingWeight": {
          "$type": "fontWeight",
          "$value": 400
