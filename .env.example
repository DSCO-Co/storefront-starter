# ─────────────────────────────────────────────────────────────────────────
# Flightdeck headless storefront — environment
#
# Copy to `.env.local` for local dev, or set these in your Vercel project
# (Project → Settings → Environment Variables) for a deployed store.
#
# The only SECRET here is FLIGHTDECK_STOREFRONT_TOKEN (and SESSION_SECRET).
# Everything else is safe to commit. Nothing prefixed NEXT_PUBLIC_ is secret —
# those are inlined into the browser bundle by design.
# ─────────────────────────────────────────────────────────────────────────

# ── REQUIRED ───────────────────────────────────────────────────────────────

# The commerce API origin your store reads catalog + places orders against.
FLIGHTDECK_API_URL="https://api.ruo.pro"

# The tenant THIS deployment serves. Setting it pins the store to one tenant
# and ignores the request Host entirely — so the store renders on an ephemeral
# *.vercel.app preview URL, and before you've pointed a custom domain at it.
# This is your store's tenant ref, issued when your store was provisioned.
FLIGHTDECK_TENANT="your-store-tenant-ref"

# The narrow, tenant-scoped storefront credential (`x-storefront-token`).
# SERVER-SIDE ONLY — it authorizes placing orders for your tenant. It is read
# only in server code (Route Handlers) and never shipped to the browser.
# Rotate it any time from your merchant console; treat it like a password.
FLIGHTDECK_STOREFRONT_TOKEN="sft_replace_me"

# Signing secret for shopper account sessions (any long random string, e.g.
# `openssl rand -hex 32`). Without it, account sign-in degrades to guest
# checkout — checkout still works, order history does not.
SESSION_SECRET="replace_with_a_long_random_string"

# ── OPTIONAL ───────────────────────────────────────────────────────────────

# CDN base + available variants for product/brand imagery. Leave unset to use
# the platform's asset host.
# NEXT_PUBLIC_ASSET_BASE_URL="https://assets.ruo.pro"
# NEXT_PUBLIC_ASSET_VARIANTS="thumb,card,hero"

# Client + server error reporting (Sentry). Leave unset to disable.
# NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_ENV="production"

# ── LOCAL DEV ONLY ─────────────────────────────────────────────────────────
# Leave FLIGHTDECK_API_URL unset locally to serve bundled demo fixtures with
# no running platform. In production that fallback is refused (fail-closed) —
# it never silently serves a demo catalog under a live domain.
# ALLOW_FIXTURE_MODE="1"
